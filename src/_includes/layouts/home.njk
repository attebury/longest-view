---
layout: layouts/base.njk
---

<section class="page">
  
  {{ content | safe }}

  <h2>Recent posts</h2>
  <ul>
    {% for post in collections.recentPosts %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        — {{ post.date | date("yyyy-MM-dd") }}
      </li>
    {% endfor %}
  </ul>
  <p><a href="/blog.html">All posts</a></p>
</section>
