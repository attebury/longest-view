---
layout: layouts/page.njk
title: Archive
permalink: /archive/index.html
---

{% set years = collections.posts | groupByYear %}
{% for year, posts in years %}
<section>
  <h2>{{ year }}</h2>
  <ul>
    {% for post in posts %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        — {{ post.date | date("yyyy-MM-dd") }}
      </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
