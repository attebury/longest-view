<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
    {% set metaDescription = description or site.description %}
    <meta name="description" content="{{ metaDescription | escape }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ metaDescription | escape }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}{{ site.name }}">
    <meta name="twitter:description" content="{{ metaDescription | escape }}">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml">
    <link rel="stylesheet" href="/assets/main.css">
  </head>
  <body>
    <header>
      <a href="/">The Longest View</a>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p><a href="/">The Longest View</a> · <a href="/blog.html">Blog</a> · <a href="/tags/">Tags</a> · <a href="/archive/">Archive</a></p>
    </footer>
  </body>
</html>

